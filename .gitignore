# ---- Unity (based on github/gitignore Unity.gitignore) ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated by Unity / IDEs
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta
*.vsconfig

# Crash reports / recovery
sysinfo.txt
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.app
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# Gradle cache
/[Aa]ssets/Plugins/Android/gradleOut*
/[Aa]ssets/StreamingAssets/aa.meta
/[Aa]ssets/StreamingAssets/aa/*

# Secrets / tooling
.env
.env.*
.claude/

# ---- Third-party content NOT redistributed in this repo ----
# Unity Asset Store packs (Asset Store EULA does not allow public redistribution)
/Assets/Flooded_Grounds/
/Assets/Flooded_Grounds.meta
/Assets/Backrooms Forever DEMO/
/Assets/Backrooms Forever DEMO.meta
# Mixamo characters (Remy, Prisoner B Styperek) - download from mixamo.com
/Assets/TexturesRemy/
/Assets/TexturesRemy.meta
/Assets/Animations/*.fbx
/Assets/Animations/*.fbx.meta
/Assets/EnemyAnimations/*.fbx
/Assets/EnemyAnimations/*.fbx.meta
/Assets/EnemyAnimations/prisoner_*.png
/Assets/EnemyAnimations/prisoner_*.png.meta
# Copyrighted music / third-party audio
*.mp3
*.mp3.meta
